# ============================================================================
# The Agency — example environment configuration.
# Copy to `.env` and fill in values:  cp .env.example .env
#
# Precedence: built-in defaults < .env file < real environment variables.
# Never commit a filled-in `.env` to version control.
# ============================================================================

# --- LLM --------------------------------------------------------------------
# Provider name. Supported: openai, anthropic, google, gemini, mistral,
# ollama (keyless/local), azure, cohere, groq, together, deepseek, xai,
# perplexity, openrouter. Custom OpenAI-compatible endpoints work with
# llm_provider=openai plus llm_base_url.
AGENCY_LLM_PROVIDER=openai

# Model identifier for the selected provider, e.g. gpt-4o-mini,
# claude-3-5-sonnet-latest, llama3.1 (ollama).
AGENCY_LLM_MODEL=gpt-4o-mini

# Default API key for the active provider. Prefer per-provider keys managed
# via `agency config set-key <provider> <key>` (AGENCY_<PROVIDER>_API_KEY).
AGENCY_LLM_API_KEY=

# Optional custom API base URL for OpenAI-compatible endpoints
# (e.g. http://localhost:11434/v1 for Ollama, Azure endpoint URL).
AGENCY_LLM_BASE_URL=

# --- Provider API keys (managed by `agency config set-key`) -----------------
# AGENCY_OPENAI_API_KEY=sk-...
# AGENCY_ANTHROPIC_API_KEY=sk-ant-...
# AGENCY_GOOGLE_API_KEY=AIza...
# AGENCY_GROQ_API_KEY=gsk_...
# AGENCY_XAI_API_KEY=xai-...
# AGENCY_PERPLEXITY_API_KEY=pplx-...
# AGENCY_OPENROUTER_API_KEY=sk-or-...

# --- Server ("butler") ------------------------------------------------------
# Interface and port for the Agency API server (`agency start`).
AGENCY_BUTLER_HOST=127.0.0.1
AGENCY_BUTLER_PORT=8000

# --- Storage ----------------------------------------------------------------
# SQLite database paths (relative to the project root or absolute).
AGENCY_MEMORY_DB_PATH=data/memory.db
AGENCY_EVIDENCE_DB_PATH=data/evidence.db
AGENCY_AUDIT_DB_PATH=data/audit.db

# --- Logging ----------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
AGENCY_LOG_LEVEL=INFO
