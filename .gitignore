# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# `lib/` above is for C build outputs — gui source helpers live in gui/src/lib
# and must be tracked (the format.ts helpers were silently dropped once).
!gui/src/lib/
!gui/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Nexus specific
qa-data/
sandbox-workspaces/
*.log

# Environment / secrets (never commit filled-in .env files)
.env
.env.*
!.env.example

# Mutable runtime data stays local; preserve the directory in fresh clones.
data/*
!data/.gitkeep
!data/agents/
!data/agents/agents.yaml

# Private Butler intelligence documents (owner persona/charter; never commit).
data/intelligence/

# Temporary coding-agent inputs and tool caches
.agent-input/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
.athena/
data/memory.db
data/memory.db-shm
data/memory.db-wal
data/remex_profiles.db
data/remex_profiles.db-wal
data/remex_profiles.db-shm
.tmp_gossip/

# Quarantined external clones imported by scripts/import_external_agents_skills.py.
# Each holds its own .git; committing them would add broken gitlinks with no URL.
workspace/inbox/

# Phased agent build prompts and logs
.agent-prompts/

# Zero-loss preservation artifacts (bundle/tars/patches/manifest) — kept on disk,
# not versioned; git objects are independently preserved by preserve/* tags.
/recovered/
